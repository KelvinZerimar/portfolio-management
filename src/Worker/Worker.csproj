<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- Intentionally the same UserSecretsId as WebApi.MinimalAPI: the Worker reuses AddInfrastructure's
         config (DB connection string, Jwt, CoinGecko, Encryption) plus its own Email settings, and both
         processes are run by the same single developer, so sharing one secrets.json avoids keeping two
         copies of the same secrets in sync. -->
    <UserSecretsId>daa01fcc-134f-4f9c-b600-67504a448d77</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Worker has no direct EF Core package of its own, so without this pin NuGet's restore
         resolves Microsoft.EntityFrameworkCore.Relational to the lowest version satisfying its
         transitive constraints (10.0.4) instead of the 10.0.12 Infrastructure.csproj was actually
         compiled against - only 10.0.4 then gets copied to the output folder, and the app throws
         FileNotFoundException for 10.0.12 at the first EF Core call. Must match Infrastructure's
         Microsoft.EntityFrameworkCore version exactly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

</Project>
