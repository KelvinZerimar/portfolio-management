{
  "ApplicationInsights": {
    "ConnectionString": "",
    "SamplingRatio": 0.2
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60
  },
  "CoinGecko": {
    "BaseUrl": "https://api.coingecko.com/api/v3/"
  },
  "Ai": {
    "Provider": "Ollama",
    "MaxAllowedToolLoops": 5,
    "RequestTimeoutSeconds": 240,
    "MafAgent": {
      "EnableWriteProposals": false
    },
    "FastModel": {
      "ModelId": "qwen2.5:3b-instruct",
      "Endpoint": "http://localhost:11434/v1"
    },
    "ReasoningModel": {
      "ModelId": "qwen2.5:3b-instruct",
      "Endpoint": "http://localhost:11434/v1"
    }
  }
}
